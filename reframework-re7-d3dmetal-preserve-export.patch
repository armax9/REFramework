--- a/src/D3D12Hook.cpp
+++ b/src/D3D12Hook.cpp
@@ -195,7 +195,23 @@
     spdlog::info("Creating dummy device");
 
     // Get the original on-disk bytes of the D3D12CreateDevice export
-    const auto original_bytes = utility::get_original_bytes(d3d12_create_device);
+    char preserve_value[8]{};
